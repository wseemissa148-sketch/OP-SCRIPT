    Button.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
    Button.Text = "  " .. name
    Button.TextColor3 = _G.Config[configVar] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
    Button.Font = Enum.Font.GothamMedium
    Button.TextSize = 9
    Button.TextXAlignment = Enum.TextXAlignment.Left

    local BtnCorner = Instance.new("UICorner", Button)
    BtnCorner.CornerRadius = UDim.new(0, 6)

    local Indicator = Instance.new("Frame", Button)
    Indicator.Size = UDim2.new(0, 26, 0, 14)
    Indicator.Position = UDim2.new(1, -32, 0.5, -7)
    Indicator.BackgroundColor3 = _G.Config[configVar] and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(45, 50, 62)

    local IndCorner = Instance.new("UICorner", Indicator)
    IndCorner.CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame", Indicator)
    Dot.Size = UDim2.new(0, 8, 0, 8)
    Dot.Position = _G.Config[configVar] and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
    Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    local DotCorner = Instance.new("UICorner", Dot)
    DotCorner.CornerRadius = UDim.new(1, 0)

    Button.MouseButton1Click:Connect(function()
        _G.Config[configVar] = not _G.Config[configVar]
        SaveConfig()
        local state = _G.Config[configVar]
        Indicator.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(45, 50, 62)
        Dot.Position = state and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        Button.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        if callback then callback(state) end
    end)
    return Button
end

local function CreateDynamicDropdown(parentPage, title, getOptionsFunc, configVar, onSelectCallback)
    local DropdownFrame = Instance.new("Frame", parentPage)
    DropdownFrame.Size = UDim2.new(0.96, 0, 0, 30)
    DropdownFrame.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
    DropdownFrame.ClipsDescendants = true

    local FrameCorner = Instance.new("UICorner", DropdownFrame)
    FrameCorner.CornerRadius = UDim.new(0, 6)

    local MainBtn = Instance.new("TextButton", DropdownFrame)
    MainBtn.Size = UDim2.new(1, 0, 0, 30)
    MainBtn.BackgroundTransparency = 1
    MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
    MainBtn.TextColor3 = Color3.fromRGB(0, 170, 255)
    MainBtn.Font = Enum.Font.GothamBold
    MainBtn.TextSize = 9
    MainBtn.TextXAlignment = Enum.TextXAlignment.Left

    local OptionsHolder = Instance.new("ScrollingFrame", DropdownFrame)
    OptionsHolder.Position = UDim2.new(0, 4, 0, 30)
    OptionsHolder.Size = UDim2.new(1, -8, 0, 0)
    OptionsHolder.BackgroundTransparency = 1
    OptionsHolder.ScrollBarThickness = 3
    OptionsHolder.Visible = false

    local HolderLayout = Instance.new("UIListLayout", OptionsHolder)
    HolderLayout.Padding = UDim.new(0, 3)

    local isOpen = false

    local function RebuildOptions()
        for _, child in pairs(OptionsHolder:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local currentOptions = getOptionsFunc()
        local itemHeight = 22
        local maxVisibleItems = 5
        local visibleCount = math.min(#currentOptions, maxVisibleItems)
        local containerHeight = visibleCount * (itemHeight + 3)

        OptionsHolder.Size = UDim2.new(1, -8, 0, containerHeight)
        OptionsHolder.CanvasSize = UDim2.new(0, 0, 0, #currentOptions * (itemHeight + 3))

        for _, opt in ipairs(currentOptions) do
            local OptBtn = Instance.new("TextButton", OptionsHolder)
            OptBtn.Size = UDim2.new(0.98, 0, 0, itemHeight)
            OptBtn.BackgroundColor3 = Color3.fromRGB(32, 36, 50)
            OptBtn.Text = tostring(opt)
            OptBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            OptBtn.Font = Enum.Font.GothamMedium
            OptBtn.TextSize = 9

            local OptCorner = Instance.new("UICorner", OptBtn)
            OptCorner.CornerRadius = UDim.new(0, 5)

            OptBtn.MouseButton1Click:Connect(function()
                _G.Config[configVar] = opt
                SaveConfig()
                MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
                isOpen = false
                OptionsHolder.Visible = false
                DropdownFrame.Size = UDim2.new(0.96, 0, 0, 30)
                if onSelectCallback then onSelectCallback(opt) end
            end)
        end
        return containerHeight
    end

    MainBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local containerHeight = RebuildOptions()
            OptionsHolder.Visible = true
            DropdownFrame.Size = UDim2.new(0.96, 0, 0, 34 + containerHeight)
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▲"
        else
            OptionsHolder.Visible = false
            DropdownFrame.Size = UDim2.new(0.96, 0, 0, 30)
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
        end
    end)

    return {
        Refresh = function()
            MainBtn.Text = "  " .. title .. ": " .. tostring(_G.Config[configVar]) .. "  ▼"
            if isOpen then 
                local containerHeight = RebuildOptions()
                DropdownFrame.Size = UDim2.new(0.96, 0, 0, 34 + containerHeight)
            end
        end
    }
end

