end)

local function ExecuteCustomPVPCombo(targetPlr)
    if not targetPlr or not targetPlr.Character then return end
    local pHrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
    local pHum = targetPlr.Character:FindFirstChild("Humanoid")
    local char = LocalPlayer.Character

    if pHrp and pHum and pHum.Health > 0 and char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(pHrp.Position - (pHrp.CFrame.LookVector * 2.5), pHrp.Position)
        workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, pHrp.Position)

        for _, wType in ipairs(_G.Config.ComboSequence) do
            if not _G.Config.TargetPVP then break end
            if _G.Config.ComboWeaponEnabled[wType] then
                EquipSpecificWeapon(wType)
                task.wait(0.05)

                local skillSet = _G.Config.ComboSkills[wType]
                if skillSet then
                    local keys = {
                        {Key = Enum.KeyCode.Z, Enabled = skillSet.Z},
                        {Key = Enum.KeyCode.X, Enabled = skillSet.X},
                        {Key = Enum.KeyCode.C, Enabled = skillSet.C},
                        {Key = Enum.KeyCode.V, Enabled = skillSet.V},
                        {Key = Enum.KeyCode.F, Enabled = skillSet.F}
                    }
                    for _, kData in ipairs(keys) do
                        if kData.Enabled then
                            VirtualInputManager:SendKeyEvent(true, kData.Key, false, game)
                            task.wait(0.04)
                            VirtualInputManager:SendKeyEvent(false, kData.Key, false, game)
                        end
                    end
                end
                task.wait(0.25)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if KeyUnlocked then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                if _G.Config.IsTeleporting then
                    local seaIslands = islandsBySea[_G.Config.SelectedIslandSea]
                    if _G.Config.SelectIsland ~= "" and seaIslands and seaIslands[_G.Config.SelectIsland] then
                        local targetPos = seaIslands[_G.Config.SelectIsland]
                        if (char.HumanoidRootPart.Position - targetPos).Magnitude > 15 then
                            SmoothMove(CFrame.new(targetPos + Vector3.new(0, 30, 0)))
                        else
                            _G.Config.IsTeleporting = false
                            if currentTween then currentTween:Cancel() end
                        end
                    end
                else
                    if _G.Config.AutoFarm then
                        EquipSpecificWeapon(_G.Config.SelectWeapon)
                        local enemies = workspace:FindFirstChild("Enemies")
                        local targetMob = nil
                        if enemies then
                            for _, mob in pairs(enemies:GetChildren()) do
                                local mHum = mob:FindFirstChild("Humanoid")
                                if mHum and mHum.Health > 0 then targetMob = mob; break end
                            end
                        end
                        if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                            SmoothMove(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0))
                        end
                    elseif _G.Config.AutoMaterial then
                        EquipSpecificWeapon(_G.Config.SelectWeapon)
                        local enemies = workspace:FindFirstChild("Enemies")
                        local targetMob = nil
                        local mobName = materialToMob[_G.Config.SelectMaterial] or ""
                        if enemies then
                            for _, mob in pairs(enemies:GetChildren()) do
                                local mHum = mob:FindFirstChild("Humanoid")
                                if mob.Name:find(mobName) and mHum and mHum.Health > 0 then
                                    targetMob = mob
                                    break
                                end
                            end
                        end
                        if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                            SmoothMove(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0))
                        end
                    elseif _G.Config.TargetPVP and _G.Config.SelectedPlayer ~= "" then
                        local targetPlr = Players:FindFirstChild(_G.Config.SelectedPlayer)
                        if targetPlr then ExecuteCustomPVPCombo(targetPlr) end
                    end
                end
            end
        end
    end
end)

