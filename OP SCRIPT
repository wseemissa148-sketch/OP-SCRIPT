table.insert(Connections, UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end))

table.insert(Connections, RunService.Heartbeat:Connect(function(delta)
    if _G.Config.SpeedEnabled and KeyUnlocked then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (_G.Config.SpeedMultiplier * 14) * delta)
            end
        end
    end
end))

getgenv().UniversalSpeedHubCleanUp = function()
    for _, conn in ipairs(Connections) do
        if conn then conn:Disconnect() end
    end
    ClearAllHealthBars()
    if ScreenGui then ScreenGui:Destroy() end
end
